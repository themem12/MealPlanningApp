{
  "sourceLanguage" : "en",
  "strings" : {
    "%@, %@" : {
      "comment" : "A button that opens a meal detail view. The label is a combination of the meal type and a localized string for \"Open meal details\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A label displaying the number of days in a given category. The argument is the number of days in the category.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
          }
        }
      }
    },
    "•" : {
      "comment" : "A dot that is used to separate items in a list.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "•"
